{
  // Starlight puts the title in frontmatter, so pages have no H1.
  "globs": ["src/content/docs/**/*.md"],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD046": { "style": "fenced" },
    "MD004": { "style": "dash" }
  }
}
