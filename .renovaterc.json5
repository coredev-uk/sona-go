{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":timezone(Europe/London)",
    ":semanticCommits",
  ],
  // Clarence merges, so Renovate never does
  automerge: false,
  // Only rebase on conflicts; Clarence serialises merges itself
  rebaseWhen: "conflicted",
  prHourlyLimit: 4,
  prConcurrentLimit: 10,
  // The dashboard issue, in Clarence's voice: Renovate finds updates, Clarence merges
  dependencyDashboardTitle: "📦 Renovate Dashboard",
  dependencyDashboardHeader: "## 📦 Renovate Dashboard\n\n> 📻 **Reporting in.** Every update Renovate found in Sona is below. Renovate only opens the pull requests: Clarence, the repository's merge bot, rules on each one, and a merge counts once CI passes on `main`. Tick a box to make Renovate act on the next run.\n\n| | |\n|---|---|\n| **Merged by** | Clarence, see its card on each pull request |\n| **Verified by** | `Go vet and test (-race)` on `main` |\n",
  dependencyDashboardFooter: "<sub>📻 Renovate · runs every two hours from `.github/workflows/renovate.yaml` · merges go through Clarence</sub>",
  // Covers go.mod, .github/workflows and the images' Containerfiles (the
  // digests their FROM lines and the workflows' container: images name).
  // devenv.lock is not a Renovate manager file; bump nixpkgs by hand
  // (docs/maintainers/repository.md, "Pinned inputs"). The tools the release
  // build downloads (build/linux/appimage-tools.sha256, build/windows/*.sha256,
  // the Go archive hashes) are moved by hand too: Renovate cannot compute a hash.
  enabledManagers: ["gomod", "github-actions", "dockerfile", "npm"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  packageRules: [
    {
      // The base images are chosen here: Ubuntu 24.04 is the release
      // baseline (the glibc the packages run on), 26.04 the CI image's, and
      // the Flatpak builder's tag names its GNOME runtime. Renovate only keeps
      // each pinned digest current (they are updated weekly), never moves to
      // another tag.
      description: "Container base images: digests only, weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["major", "minor", "patch"],
      enabled: false,
    },
    {
      description: "Container base images: refresh the pinned digest weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      schedule: ["before 6am on monday"],
    },
    {
      // CI never builds this image: the release run does, so its base is read
      // by a person before it moves.
      description: "Release build image: review every digest update",
      matchFileNames: ["build/linux/release/Containerfile"],
      addLabels: ["verdict/review"],
    },
    {
      // The npm manager reads only site/ (the docs site and its markdownlint
      // dev tooling), the repository's one package.json. Its updates are
      // grouped into one weekly pull request, so the site never floods the queue.
      description: "site/ npm dependencies: one weekly group",
      matchManagers: ["npm"],
      groupName: "site npm dependencies",
      schedule: ["before 6am on monday"],
    },
    {
      // MyGo is young and pre-1.0: every bump is read by hand (it needs a
      // matching Go release too), so it never automerges.
      description: "MyGo: review every update",
      matchPackageNames: ["github.com/egoist/mygo"],
      automerge: false,
      addLabels: ["verdict/review"],
    },
    {
      // Proton's tags (v1, v1.0.0, v1.1.0) ship no dist/index.js, so the
      // workflows pin main's commit (v1.1.0 plus its build). Renovate would
      // move that digest back to the tag's commit and break every secrets step;
      // re-enable once a tagged release contains dist/.
      description: "protonpass/load-secret-action: pinned by hand",
      matchPackageNames: ["protonpass/load-secret-action"],
      enabled: false,
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      // Last, so it overrides config:recommended's merge-confidence rule, which
      // drops the Update column Clarence reads the update type from
      description: "Always list the update type for Clarence",
      matchPackageNames: ["*"],
      prBodyColumns: ["Package", "Type", "Update", "Change", "Age", "Confidence"],
    },
  ],
}
