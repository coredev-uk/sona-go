{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":timezone(Europe/London)",
    ":semanticCommits",
  ],
  // Clarence merges, so Renovate never does
  automerge: false,
  // Only rebase on conflicts; Clarence serialises merges itself
  rebaseWhen: "conflicted",
  prHourlyLimit: 4,
  prConcurrentLimit: 10,
  // The dashboard issue, in Clarence's voice: Renovate finds updates, Clarence merges
  dependencyDashboardTitle: "📦 Renovate Dashboard",
  dependencyDashboardHeader: "## 📦 Renovate Dashboard\n\n> 📻 **Reporting in.** Every update Renovate found in Sona is below. Renovate only opens the pull requests: Clarence, the repository's merge bot, rules on each one, and a merge counts once CI passes on `main`. Tick a box to make Renovate act on the next run.\n\n| | |\n|---|---|\n| **Merged by** | Clarence, see its card on each pull request |\n| **Verified by** | `Go vet and test (-race)` and the frontend build on `main` |\n| **Release age** | npm releases wait 3 days before Renovate opens them |\n",
  dependencyDashboardFooter: "<sub>📻 Renovate · runs every two hours from `.github/workflows/renovate.yaml` · merges go through Clarence</sub>",
  // Covers go.mod, frontend/ (pnpm) and .github/workflows. devenv.lock is not
  // a Renovate manager file; bump nixpkgs by hand (CONTRIBUTING.md)
  enabledManagers: ["gomod", "npm", "github-actions"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  packageRules: [
    {
      // Move the range in package.json with the lockfile: an update inside
      // the range would otherwise change only pnpm-lock.yaml, which Clarence
      // always sends to review. Wails, below, still pins.
      description: "Let npm releases settle, and bump their ranges",
      matchDatasources: ["npm"],
      minimumReleaseAge: "3 days",
      rangeStrategy: "bump",
    },
    {
      // The Go module and the npm runtime must move together. Wails v3 is
      // pinned to exact versions; prereleases are only offered for Wails
      // while the pinned version is itself a prerelease (Renovate's default)
      description: "Wails v3 Group",
      groupName: "wails",
      matchPackageNames: ["github.com/wailsapp/wails/v3", "@wailsio/runtime"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      rangeStrategy: "pin",
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      // Last, so it overrides config:recommended's merge-confidence rule, which
      // drops the Update column Clarence reads the update type from
      description: "Always list the update type for Clarence",
      matchPackageNames: ["*"],
      prBodyColumns: ["Package", "Type", "Update", "Change", "Age", "Confidence"],
    },
  ],
}
