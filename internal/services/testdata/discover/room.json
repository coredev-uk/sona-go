[{"buyParams": "productType=P&price=8990&salableAdamId=6810324403&pricingParameters=PLUS&pg=default", "price": 8.99, "priceFormatted": "\u00a38.99", "type": "buy"}, {"buyParams": "productType=P&price=0&salableAdamId=6810324403&pricingParameters=SUBS&pg=default", "price": 0.0, "priceFormatted": "\u00a30.00", "type": "subscription"}], "playParams": {"id": "6810324403", "kind": "album"}, "recordLabel": "Columbia", "releaseDate": "2026-10-30", "trackCount": 16, "upc": "196874736784", "url": "https://music.apple.com/gb/album/in-the-night-again/6810324403"}, "relationships": {"artists": {"href": "/v1/catalog/gb/albums/6810324403/artists", "data": [{"id": "63097617", "type": "artists", "href": "/v1/catalog/gb/artists/63097617"}]}}}, "6826021911": {"id": "6826021911", "type": "albums", "href": "/v1/catalog/gb/albums/6826021911", "attributes": {"artistName": "Zara Larsson", "artistUrl": "https://music.apple.com/gb/artist/zara-larsson/570372593", "artwork": {"bgColor": "1f1d22", "hasP3": false, "height": 3000, "textColor1": "e1a99f", "textColor2": "c9a7a4", "textColor3": "ba8d86", "textColor4": "a78b8a", "url": "https://is1-ssl.mzstatic.com/image/thumb/Music211/v4/a8/81/81/a88181fc-8ef9-d7b9-c6ea-e317f2eff531/196874823675.jpg/{w}x{h}{c}.{f}", "width": 3000}, "audioTraits": ["atmos", "lossless", "lossy-stereo", "spatial"], "copyright": "\u2117 2026 Sommer House, under exclusive license to Epic Records, a division of Sony Music Entertainment.", "editorialNotes": {"short": "The Swedish pop star performs live from our LA studios.", "standard": "Zara Larsson made a stop at Apple Music\u2019s Los Angeles studios, where the Swedish pop star performed a set live in front of fans for Apple Music Access. Her intimate show included several cuts from her fifth studio album <i>Midnight Sun</i>, like <b>\u201cGirl\u2019s Girl\u201d</b> and its megahit title track; her collab with Clean Bandit, <b>\u201cSymphony\u201d</b>; and 2015\u2019s <b>\u201cLush Life\u201d</b>.\n\nLarsson calls out one song in particular off her 2025 album. \u201cI love <b>\u2018Saturn\u2019s Return\u2019</b>. I love that song. I feel like it\u2019s very true and real. And it\u2019s vulnerable, and I don\u2019t know everything all the time. It\u2019s sort of nice to just exist,\u201d she tells Apple Music, citing a specific lyric and what it means to her. \u201c\u2018My leaves are changing/And roots grow deeper.\u2019 Because as I grow older, I feel like the more grounded I become, the more I can\u2014not change, but I can be more empathetic.\u201d\n\nAnd of course, she praises her breakthrough full-length. \u201cSome things in life, they just come together,\u201d she says. \u201cIt\u2019s just the universe and the stars aligned. I wrote a list before I released my album of what I wanted <i>Midnight Sun</i> to be. Colourful. Bright. Unapologetic. Girlhood. Internet culture. All the things that I am, essentially. And it just became that.\u201d", "tagline": "Apple Music Sessions"}, "genreNames": ["Pop", "Music"], "isCompilation": false, "isComplete": true, "isMasteredForItunes": false, "isPrerelease": false, "isSingle": false, "name": "Sessions", "offers": [{"buyParams": "productType=P&price=8990&salableAdamId=6826021911&pricingParameters=PLUS&pg=default", "price": 8.99, "priceFormatted": "\u00a38.99", "type": "buy"}, {"buyParams": "productType=P&price=0&salableAdamId=6826021911&pricingParameters=SUBS&pg=default", "price": 0.0, "priceFormatted": "\u00a30.00", "type": "subscription"}], "playParams": {"id": "6826021911", "kind": "album"}, "recordLabel": "Sommer House/Epic", "releaseDate": "2026-10-27", "trackCount": 11, "upc": "196874823675", "url": "https://music.apple.com/gb/album/sessions/6826021911"}, "relationships": {"artists": {"href": "/v1/catalog/gb/albums/6826021911/artists", "data": [{"id": "570372593", "type": "artists", "href": "/v1/catalog/gb/artists/570372593"}]}}}, "6820274859": {"id": "6820274859", "type": "albums", "href": "/v1/catalog/gb/albums/6820274859", "attr