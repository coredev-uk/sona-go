cription": {"short": "Zane and his team place their bets on 26 artists who\u2019ll define the year.", "standard": "Every year, Zane Lowe and show producer Jeremy Degan spotlight the emerging artists poised to make their mark\u2014and 2026 is no exception. \u201cThis is an incredible list of artists who have already put in the work to establish a unique and exciting space to build from,\u201d says Zane. \u201cThey are 26 fearless creatives who are pushing themselves and their peers into new territory, reminding us that the future of music always belongs to those brave enough to redefine it.\u201d"}, "editorialArtwork": {"subscriptionCover": {"bgColor": "cecece", "hasP3": false, "height": 1080, "textColor1": "000000", "textColor2": "1b1a26", "textColor3": "402f29", "textColor4": "373642", "url": "https://is1-ssl.mzstatic.com/image/thumb/Features221/v4/bc/b4/a3/bcb4a39a-58ea-f541-5449-62864a7576ee/8902aa52-1d8f-48b7-b63e-f42462d601ac.png/{w}x{h}sr.{f}", "width": 4320}, "subscriptionHero": {"bgColor": "dccdcf", "hasP3": true, "height": 1080, "textColor1": "25233a", "textColor2": "3c2d44", "textColor3": "494557", "textColor4": "5c4d60", "url": "https://is1-ssl.mzstatic.com/image/thumb/Features211/v4/18/66/33/186633d8-48bd-4afc-8369-390b1bf4c083/a73ffbe9-edb9-467f-a744-6d54375dd1e7.png/{w}x{h}sr.{f}", "width": 4320}, "superHeroWide": {"bgColor": "afb8b8", "hasP3": false, "height": 1800, "textColor1": "2f170c", "textColor2": "361f13", "textColor3": "48372e", "textColor4": "4e3d34", "url": "https://is1-ssl.mzstatic.com/image/thumb/Features211/v4/ca/7d/8f/ca7d8f7c-b914-8e49-3576-235d8b60a903/135f6450-d1c3-41a2-b485-6f90d83db1c7.png/{w}x{h}sr.{f}", "width": 4320}}, "editorialNotes": {"name": "Zane Lowe\u2019s 26 for \u201926", "short": "Zane and his team place their bets on 26 artists who\u2019ll define the year.", "standard": "Every year, Zane Lowe and show producer Jeremy Degan spotlight the emerging artists poised to make their mark\u2014and 2026 is no exception. \u201cThis is an incredible list of artists who have already put in the work to establish a unique and exciting space to build from,\u201d says Zane. \u201cThey are 26 fearless creatives who are pushing themselves and their peers into new territory, reminding us that the future of music always belongs to those brave enough to redefine it.\u201d"}, "hasCollaboration": false, "isChart": false, "lastModifiedDate": "2026-01-29T18:59:36Z", "name": "Zane Lowe\u2019s 26 for \u201926", "playParams": {"id": "pl.5e717ce9f9204dcdb08d076dfcc46ba6", "kind": "playlist", "versionHash": "65d693097e34959c792cbf537100544d3ab2fcb07b9c59a9958f5d9873a03540"}, "playlistType": "editorial", "supportsSing": false, "url": "https://music.apple.com/gb/playlist/zane-lowes-26-for-26/pl.5e717ce9f9204dcdb08d076dfcc46ba6"}}}, "apple-curators": {"990050553": {"id": "990050553", "type": "apple-curators", "href": "/v1/catalog/gb/apple-curators/990050553", "attributes": {"artwork": {"bgColor": "dadada", "hasP3": false, "height": 1080, "textColor1": "0d0a09", "textColor2": "151417", "textColor3": "363333", "textColor4": "3c3c3e", "url": "https://is1-ssl.mzstatic.com/image/thumb/Features/v4/89/16/66/891666ab-cbb0-a5ce-f84f-9a426962a4df/4d21472d-f03e-4ba2-9c63-5f8528f507d1.png/{w}x{h}bb.{f}", "width": 1080}, "editorialArtwork": {"subscriptionCover": {"bgColor": "f4f4f4", "hasP3": false, "height": 1080, "textColor1": "000000", "textColor2": "000000", "textColor3": "3f3f43", "textColor4": "574c47", "url": "https://is1-ssl.mzstatic.com/image/thumb/Features/v4/7c/ea/7f/7cea7f17-f09b-8c85-bdb1-0527ea378ff8/65d57d53-f1e3-495f-9bd6-72305c0585d1.png/{w}x{h}sr.{f}", "width": 4320}, "subscriptionHero": {"bgColor": "f4f4f4", "hasP3": true, "height": 1080, "textColor1": "0c0b0d", "textColor2": "232326", "textColor3": "3a393b", "textColor4": "4c4d4f", "url": "https://is1-ssl.mzstatic.com/image/thumb/Features/v4/23/0f/03/230f0328-5f0a-219b-7e3a-b4ac56670378/0fdb3ed0-a324-4764-a751-8fa085e0d512.png/{w}x{h}sr.{f}", "width": 4320}, "superHeroWide": {"bgColor": "f4f4f4", "hasP3": true, "height": 1800, "textColor1": "0f1013", "textColor2": "222326", "textColor3": "3d3d40", "textColor4": "4c4d4f", "url": "https://is1-ssl.mzstatic.com/image/thumb/Features/v4/bb/c2/7d/bbc27dec-7728-fb4f-8074-5f3ab77ab6ed/25825b7d-6ce4-4095-9130-5524389764e3.png/{w}x{h}sr.{f}", "width": 4320}}, "editorialNotes": {"short": "Headline interviews, breaking news and the best emerging music.", "standard": "On his namesake show and New Music Daily, Apple Music 1\u2019s flagship shows, host Zane Lowe brings users unparalleled music knowledge with headline interviews, breaking news and emerging music from around the globe every day. The Zane Lowe Show has become the world\u2019s go-to for the best brand-new music, sure, but it\u2019s also popular music\u2019s premier confessional booth: Day after day, Zane\u2014who\u2019s also Apple Music\u2019s global creative director\u2014gets the biggest, most elusive superstars to let their guards down. Laughs, tears and news-making quotes are the norm.\n\n\u201cI\u2019m a curious person, I ask questions and I guess if I\u2019m passionate about something, I\u2019ll talk about it and engage people about it. I want to start a conversation and learn,\u201d Zane explains of his approach. \u201cBecause the more you share, the more you learn, and vice versa. It\u2019s just a circle that keeps spinning.\u201d\n\nZane earns guests\u2019 trust with a music obsessive\u2019s curiosity and enthusiasm, compassionate questioning and firsthand knowledge of life as an artist. He started his music career recording and performing, and continues to write, produce and record.\n\n\u201cThe artist side of it, that really drives what I do,\u201d he explains. \u201cI\u2019m not a conventional media-type personality. I\u2019m no good at being a host, really. I\u2019m not a journalist. I don\u2019t write; I\u2019m not a writer. What I do is feel and translate.\u201d\n\nCheck out Zane on The Zane Lowe Show every Monday through Thursday on Apple Music 1 at 9 am LA, 12 pm NYC, and 5 pm LDN and New Music Daily every Friday at 9 am LA, 12 pm NYC and 5 pm LDN.", "tagline": "Apple Music"}, "kind": "Show", "name": "The Zane Lowe Show", "playlistCount": 32, "shortName": "The Zane Lowe Show", "showHostName": "Zane Lowe", "url": "https://music.apple.com/gb/curator/the-zane-lowe-show/990050553"}, "relationships": {"grouping": {"href": "/v1/catalog/gb/apple-curators/990050553/grouping", "data": [{"id": "170437", "type": "groupings", "href": "/v1/editorial/gb/groupings/170437"}]}, "playlists": {"href": "/v1/catalog/gb/apple-curators/990050553/playlists", "next": "/v1/catalog/gb/apple-curators/990050553/playlists?offset=10", "data": [{"id": "pl.5e717ce9f9204dcdb08d076dfcc46ba6", "type": "playlists", "href": "/v1/catalog/gb/playlists/pl.5e717ce9f9204dcdb08d076dfcc46ba6"}, {"id": "pl.e87c5a988c7b49229ecad9ac9c225a15", "type": "playlists", "href": "/v1/catalog/gb/playlists/pl.e87c5a988c7b49229ecad9ac9c225a15"}]}}}}, "editorial-elements": {"6503372233": {"id": "6503372233", "type": "editorial-elements", "attributes": {"collectionId": "6443262291", "displayStyle": "compact", "doNotFilter": false, "editorialElementKind": "326", "emphasize": false, "featureFirstElement": false, "lastModifiedDate": "2026-10-30T09:06:50Z", "name": "Video Highlights", "resourceTypes": ["uploaded-videos", "music-videos"], "supportedSorts": [], "type": "normal"}, "relationships": {"contents": {"data": [{"id": "6828219346", "type": "uploaded-videos", "href": "/v1/catalog/gb/uploaded-videos/6828219346"}, {"id": "6827258683", "type": "uploaded-videos", "href": "/v1/catalog/gb/uploaded-videos/6827258683"}, {"id": "6825597132", "type": "uploaded-videos", "href": "/v1/catalog/gb/uploaded-videos/6825597132"}]}, "room": {"data": [{"id": "6503372233", "type": "rooms", "href": "/v1/editorial/gb/rooms/6503372233"}]}}}, "default": {"id": "default", "type": "editorial-elements", "attributes": {"doNotFilter": false, "editorialE