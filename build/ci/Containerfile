# The image Sona's CI runs the Linux vet, type-check, core, UI and end-to-end
# jobs in (.github/workflows/ci.yml, "container:"), published by images.yml as
# ghcr.io/coredev-uk/sona-ci:<tag> for amd64 and arm64 (build/ci/tag.sh names
# the tag). Everything the jobs install from the distribution is here, so a job
# starts with the toolchain ready and the system libraries (Pango, fonts,
# GStreamer) are the same on every run until the image is rebuilt: the UI
# goldens depend on them.
#
# The playback job stays on the bare runner (it changes a host sysctl).
#
# To run what CI runs on a Mac (golden updates, docs/testing.md, "Golden
# images"): podman run --rm -v "$PWD":/src -w /src ghcr.io/coredev-uk/sona-ci:<tag> go test ./internal/ui/... -update
#
# The base image is named by digest, so a rebuild starts from the bytes this
# file names, whatever the registry's tag points at by then; Renovate moves the
# digest (it never changes the Ubuntu release: that is decided here, by hand).
FROM docker.io/library/ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db

# Links the published image to this repository, so its workflows may pull it.
LABEL org.opencontainers.image.source="https://github.com/coredev-uk/sona-go"

# The versions come from go.mod (build/ci/tag.sh): a bump there is a new image.
ARG GO_VERSION
ARG GOTESTSUM_VERSION

ENV DEBIAN_FRONTEND=noninteractive
# The packages of .github/actions/setup-linux (vet, test and e2e lists) plus
# what a container job's actions need (git for checkout, tar and zstd for
# actions/cache, jq for the scripts, curl for the Go download).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq tar zstd xz-utils \
      build-essential pkg-config \
      libgtk-3-dev libayatana-appindicator3-dev libsecret-1-dev libepoxy-dev libgl-dev \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
      gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
      gstreamer1.0-libav gstreamer1.0-tools gstreamer1.0-pipewire \
      pipewire pipewire-bin wireplumber \
      sway wtype \
      dbus dbus-daemon dbus-bin at-spi2-core libatk-bridge2.0-0t64 \
      libegl1 libegl-mesa0 libgl1-mesa-dri fonts-dejavu-core \
      zsh \
    && rm -rf /var/lib/apt/lists/*

# The workspace is the runner user's, the job runs as root: without this git
# (and so go's VCS stamping and cmd/pathcase) refuses the checkout.
RUN git config --system --add safe.directory '*'

# The Go archive is checked against go.sha256 before it is unpacked (a go.mod
# on a Go version that file lacks does not build); gotestsum is built from
# source and the go command checks its module against the Go checksum database.
COPY go.sha256 /tmp/go.sha256
RUN arch=$(dpkg --print-architecture) \
 && file=go${GO_VERSION}.linux-${arch}.tar.gz \
 && want=$(awk -v f="$file" '$2 == f { print $1 }' /tmp/go.sha256) \
 && [ -n "$want" ] || { echo "build/ci/go.sha256 has no line for ${GO_VERSION} on ${arch}" >&2; exit 1; } \
 && curl -fsSL -o "/tmp/$file" "https://go.dev/dl/$file" \
 && echo "$want  /tmp/$file" | sha256sum --check --strict \
 && tar -C /usr/local -xzf "/tmp/$file" && rm "/tmp/$file" /tmp/go.sha256 \
 && GOBIN=/usr/local/bin GOTOOLCHAIN=local /usr/local/go/bin/go install "gotest.tools/gotestsum@${GOTESTSUM_VERSION}" \
 && rm -rf /root/go /root/.cache

# golangci-lint, the release archive of build/ci/golangci-lint.sha256 (the
# version is in its file names: the one devenv.nix's nixpkgs ships, so CI lints
# with what `check` lints with), checked against that file before it is
# unpacked. It is not a `tool` of go.mod: its dependency tree is large.
COPY golangci-lint.sha256 /tmp/golangci-lint.sha256
RUN arch=$(dpkg --print-architecture) \
 && file=$(awk -v s="-linux-${arch}.tar.gz" '$1 !~ /^#/ && index($2, s) { print $2 }' /tmp/golangci-lint.sha256) \
 && want=$(awk -v f="$file" '$2 == f { print $1 }' /tmp/golangci-lint.sha256) \
 && [ -n "$file" ] && [ -n "$want" ] || { echo "build/ci/golangci-lint.sha256 has no line for ${arch}" >&2; exit 1; } \
 && version=${file#golangci-lint-} && version=${version%-linux-*} \
 && curl -fsSL -o "/tmp/$file" "https://github.com/golangci/golangci-lint/releases/download/v${version}/${file}" \
 && echo "$want  /tmp/$file" | sha256sum --check --strict \
 && tar -C /usr/local/bin -xzf "/tmp/$file" --strip-components=1 "${file%.tar.gz}/golangci-lint" \
 && rm "/tmp/$file" /tmp/golangci-lint.sha256

ENV PATH=/usr/local/go/bin:$PATH \
    CGO_ENABLED=1 \
    GOTOOLCHAIN=local
