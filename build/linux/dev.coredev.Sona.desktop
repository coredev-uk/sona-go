[Desktop Entry]
Type=Application
Name=Sona
GenericName=Music Player
Comment=Listen to Apple Music
Exec=sona %u
Icon=sona
Terminal=false
SingleMainWindow=true
StartupWMClass=dev.coredev.Sona
Categories=AudioVideo;Audio;Player;
Keywords=apple;music;player;itunes;streaming;lyrics;
MimeType=x-scheme-handler/music;x-scheme-handler/musics;x-scheme-handler/itms;x-scheme-handler/itmss;
