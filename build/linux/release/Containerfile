# Release build environment for Sona's Linux packages.
#
# Binaries built inside devenv on NixOS link against /nix/store and only run
# there, so releases are built on Ubuntu 24.04 (glibc 2.39, GTK 3.24,
# GStreamer 1.24): the .deb/.rpm/AppImage then run on that baseline and newer
# distros. MyGo loads GTK3, libepoxy, the tray and AT-SPI by soname at run
# time (purego), so the build needs only GStreamer's headers (cgo) and no
# GTK headers; GTK's -dev packages are here for the AppImage, which bundles
# the libraries. Used by build/linux/release/release.sh; not for development.
FROM docker.io/library/ubuntu:24.04

ARG GO_VERSION=1.27.3

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils git file binutils patchelf \
      build-essential pkg-config \
      libgtk-3-dev libepoxy-dev libayatana-appindicator3-dev \
      libsecret-1-dev at-spi2-core libegl1 libxtst-dev \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
      gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
      gstreamer1.0-libav gstreamer1.0-pulseaudio gstreamer1.0-tools \
      librsvg2-common \
    && rm -rf /var/lib/apt/lists/*

ARG TASK_VERSION=v3.44.1

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" | tar -C /usr/local -xz \
 && GOBIN=/usr/local/bin GOTOOLCHAIN=local /usr/local/go/bin/go install "github.com/go-task/task/v3/cmd/task@${TASK_VERSION}"

ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH \
    CGO_ENABLED=1 \
    GOTOOLCHAIN=local

WORKDIR /src
