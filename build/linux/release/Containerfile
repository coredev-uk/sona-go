# Release build environment for Sona's Linux packages.
#
# Binaries built inside devenv on NixOS link against /nix/store and only run
# there, so releases are built on Ubuntu 24.04 (glibc 2.39, GTK 3.24,
# GStreamer 1.24): the .deb/.rpm/AppImage then run on that baseline and newer
# distros. MyGo loads GTK3, libepoxy, the tray and AT-SPI by soname at run
# time (purego), so the build needs only GStreamer's headers (cgo) and no
# GTK headers; GTK's -dev packages are here for the AppImage, which bundles
# the libraries. Used by build/linux/release/release.sh; not for development.
#
# The base image is named by digest, and release.sh pulls exactly the image
# this line names: a release never builds on whatever the tag points at that
# day. Renovate moves the digest (never the Ubuntu release: the baseline is
# chosen by hand, for the glibc the packages run on).
FROM docker.io/library/ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289

LABEL org.opencontainers.image.source="https://github.com/coredev-uk/sona-go"

ARG GO_VERSION=1.27.4

# zsync: zsyncmake, which the pinned linuxdeploy AppImage plugin calls for the
# .zsync file but (unlike its rolling `continuous` build) does not bundle.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils git file binutils patchelf \
      build-essential pkg-config \
      libgtk-3-dev libgtk-3-bin libglib2.0-bin shared-mime-info libepoxy-dev libayatana-appindicator3-dev \
      at-spi2-core libegl1 \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
      gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
      gstreamer1.0-libav gstreamer1.0-pulseaudio gstreamer1.0-tools \
      librsvg2-common \
      zsync \
    && rm -rf /var/lib/apt/lists/*

ARG TASK_VERSION=v3.44.1
# The SHA-256 of go${GO_VERSION}.linux-amd64.tar.gz (https://go.dev/dl/?mode=json):
# change it with GO_VERSION. task is built from source, and the go command
# checks the module against the Go checksum database.
ARG GO_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840

RUN curl -fsSL -o /tmp/go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
 && echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum --check --strict \
 && tar -C /usr/local -xzf /tmp/go.tar.gz && rm /tmp/go.tar.gz \
 && GOBIN=/usr/local/bin GOTOOLCHAIN=local /usr/local/go/bin/go install "github.com/go-task/task/v3/cmd/task@${TASK_VERSION}"

ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH \
    CGO_ENABLED=1 \
    GOTOOLCHAIN=local

WORKDIR /src
