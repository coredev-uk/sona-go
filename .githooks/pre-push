#!/bin/sh
# Refuses pushes to main: Clarence merges pull requests into it; nothing else writes it.
# Emergencies only: SONA_ALLOW_MAIN=1 git push ...
[ "${SONA_ALLOW_MAIN:-}" = "1" ] && exit 0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		echo "pre-push: refusing to push to main. Push your branch and open a pull request:" >&2
		echo "  git push -u origin HEAD && gh pr create --fill" >&2
		exit 1
	fi
done
exit 0
